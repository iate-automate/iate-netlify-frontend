---
const {landing, headerImg} = Astro.props
---

<header class={landing ? "landing" : ""} style={landing ? `background-image: url('${headerImg}');` : ""}>
    <div class="logo">
        <a href="https://artspsychotherapy.org">
            <img src="/images/logo-iate.png" alt="IATE Logo" />
        </a>
    </div>
    <nav>
        <a class="nav-link" href="https://artspsychotherapy.org/contact-us">Help & Support</a>
    </nav>
</header>

<style>

    header {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 var(--margin-medium);
        position: relative;
        padding: var(--site-gutter-block) var(--site-gutter-inline);
    }

    .logo {
        width: 120px;
    }

    .logo img {
        width: 100%;
    }

    @media only screen and (min-width: 769px) {
        .logo {
            width: 160px;
        }
    }

    nav {
        display: flex;
        justify-content: flex-end;
    }

    .landing {
        background-position: center;
        background-size: cover;
    }

    .landing .nav-link {
        color: var(--color-white);
        text-decoration: none;
    }

</style>